# Keep real values only in the Oracle VM environment file. Never commit this file with secrets.
# Required administrator account. Set real values only in the Oracle/local environment.
ADMIN_USERNAME=
ADMIN_PASSWORD=
SESSION_TTL_HOURS=12
DATABASE_URL=

# Portable browser worker (Android APK, Windows PC, or another host).
# The worker keeps portal sessions locally and only pushes sanitized utility
# results to the Oracle VM. Generate a long random token and set the same value on
# the worker; never put portal passwords or DATABASE_URL in the APK.
SCRAPER_WORKER_ENABLED=false
SCRAPER_WORKER_TOKEN=
SERVICES_EXECUTION_MODE=portable
SERVICES_SCRAPE_INTERVAL_HOURS=1
PORTABLE_WORKER_INTERVAL_HOURS=1
PORTABLE_WORKER_START_AT=07:00
PORTABLE_WORKER_TIMEZONE=America/Bogota
PORTABLE_WORKER_PROVIDERS=air-e,water,gas

# Local security gateway (mini PC beside the NVR). The Oracle server stores only roles,
# short-lived tickets and audit events; it never stores camera credentials or
# continuous video. EDGE_GATEWAY_URL must be a public HTTPS endpoint.
EDGE_GATEWAY_URL=
EDGE_GATEWAY_TOKEN=
# Public metadata only. gatewayId must match the local gateway configuration.
# Mark only the front camera and intended pedestrian gate as tenantVisible.
CAMERA_STREAMS_JSON=[{"id":"front","gatewayId":"front","name":"Frente","location":"Portería","tenantVisible":true,"enabled":true}]
ACCESS_DOORS_JSON=[{"id":"front-gate","gatewayId":"front-gate","name":"Reja peatonal","location":"Entrada","tenantVisible":false,"enabled":true}]

# WhatsApp Business Platform / Cloud API
WHATSAPP_CLOUD_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Set this to the current Graph API version shown in Meta for Developers.
WHATSAPP_GRAPH_VERSION=
# Approved Meta template used to reopen a tenant conversation.
WHATSAPP_GREETING_TEMPLATE=saludo_inquilino
# Approved Meta template with 12 body variables: cobro_canon_servicios
WHATSAPP_PAYMENT_REMINDER_TEMPLATE=cobro_canon_servicios
# Approved administrator reminder with 15 body variables, sent at 08:00 Colombia time.
WHATSAPP_ADMIN_PAYMENT_REMINDER_TEMPLATE=recordatorio_admin_cobros
# Approved administrator notice sent when a payment is matched to one apartment.
WHATSAPP_ADMIN_PAYMENT_CONFIRMED_TEMPLATE=pago_confirmado_admin
# Approved administrator template used when a payment needs manual apartment association.
WHATSAPP_PAYMENT_REVIEW_TEMPLATE=pago_por_asociar
# Set to false only while using an old review template without quick-reply buttons.
WHATSAPP_PAYMENT_REVIEW_BUTTONS=true
# OCR local para comprobantes enviados por WhatsApp. No confirma pagos por sí solo.
PAYMENT_OCR_ENABLED=true
# spa+eng se descarga una sola vez en el worker de OCR y se reutiliza en memoria.
PAYMENT_OCR_LANGUAGE=spa+eng
PAYMENT_OCR_MAX_BYTES=16777216
PAYMENT_OCR_MAX_PDF_PAGES=3
PAYMENT_OCR_TIMEOUT_MS=90000
# Leave the remote source-code editor off unless you have a temporary, controlled need.
EDITOR_ENABLED=false
EDITOR_USERNAME=
EDITOR_PASSWORD=

# Cloud API is the production channel. Leave the legacy Baileys relay disabled.
AUTO_START_BOT=false
ENABLE_LEGACY_BAILEYS=false

# --- Login con GitHub (OAuth, admin desde cualquier PC) ---
# Crear OAuth App en GitHub con callback https://<dominio>/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Logins de GitHub autorizados como admin, separados por comas
GITHUB_ADMIN_USERS=
# Opcional: forzar un callback distinto al derivado del dominio
# GITHUB_OAUTH_CALLBACK=https://conjunto-residendial-laujim.duckdns.org/api/auth/github/callback

# --- Base durable Aiven (segunda copia de datos y secretos) ---
AIVEN_DATABASE_URL=
# Password del Postgres local de la VM (docker-compose)
DB_PASSWORD=

# --- APKs (rotacion local ultimas 10, nunca en git) ---
# Base publica para descargar la APK (la sirve app-version.json)
PUBLIC_APK_BASE_URL=https://conjunto-residendial-laujim.duckdns.org
# Fijado automaticamente por release-apk.cjs (no editar)
# LAUJIM_APK_FILE=releases/laujim-v1.0.23.apk

# --- Respaldos S3/R2 (fotos, backups, snapshots del grafo) ---
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# R2_ENDPOINT=

# --- Truecaller (Caller ID opcional) ---
# TRUECALLER_ENABLED=false
# TRUECALLER_COOKIE=
# TRUECALLER_INSTALLATION_ID=

# --- Lectura remota del grafo (IAs sin clonar, solo HTTP + token) ---
GRAPH_READER_TOKEN=
