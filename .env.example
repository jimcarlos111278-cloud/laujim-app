# Keep real values only in Render environment variables. Never commit this file with secrets.
# Required administrator account. Set real values only in Render/local environment.
ADMIN_USERNAME=
ADMIN_PASSWORD=
SESSION_TTL_HOURS=12
DATABASE_URL=

# WhatsApp Business Platform / Cloud API
WHATSAPP_CLOUD_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Set this to the current Graph API version shown in Meta for Developers.
WHATSAPP_GRAPH_VERSION=
# Approved Meta template used to reopen a tenant conversation.
WHATSAPP_GREETING_TEMPLATE=saludo_inquilino
# Approved Meta template with 12 body variables: cobro_canon_servicios
WHATSAPP_PAYMENT_REMINDER_TEMPLATE=cobro_canon_servicios
# Leave the remote source-code editor off unless you have a temporary, controlled need.
EDITOR_ENABLED=false
EDITOR_USERNAME=
EDITOR_PASSWORD=

# Cloud API is the production channel. Leave the legacy Baileys relay disabled.
AUTO_START_BOT=false
ENABLE_LEGACY_BAILEYS=false
