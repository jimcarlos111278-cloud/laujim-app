#!/bin/sh
# El grafo de graphify es un artefacto LOCAL y NO se commitea: es demasiado
# grande para GitHub y su regeneracion escanea caches enormes (Gradle, node_modules)
# que cuelgan el commit. La regeneracion se hace manualmente con:
#   npm run graphify   (o)   graphify update .
# Este hook solo garantiza que graphify-out/ nunca quede staged en un commit.
# Hook instalado en .git/hooks/pre-commit mediante scripts/setup-graphify-hooks.cjs

# Si por error alguien hizo `git add graphify-out/`, lo saca del index.
if git rev-parse --git-dir >/dev/null 2>&1 && [ -d "graphify-out" ]; then
  git rm -r --cached --quiet graphify-out/ 2>/dev/null || true
fi

exit 0