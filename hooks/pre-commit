#!/bin/sh
# Regenera el grafo de graphify antes de cada commit y lo incluye en el commit.
# Hook instalado en .git/hooks/pre-commit mediante scripts/setup-graphify-hooks.cjs

echo "[graphify] regenerando grafo antes del commit..."
if ! node scripts/graphify-update.cjs; then
  echo "[graphify] fallo al regenerar el grafo; abortando commit." >&2
  exit 1
fi

# Los archivos del grafo regenerado deben quedar estaqueados en el commit actual.
if git rev-parse --git-dir >/dev/null 2>&1 && [ -d "graphify-out" ]; then
  git add graphify-out/ 2>/dev/null || true
fi

exit 0