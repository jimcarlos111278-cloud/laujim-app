FROM python:3.12-slim-bookworm

# Instalar FFmpeg y Tesseract OCR nativos para ARM64
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    tesseract-ocr \
    tesseract-ocr-spa \
    procps \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Instalar dependencias de Python (incluye OpenCV/numpy/requests: el motor los importa al arrancar)
# ultralytics: detección de vehículos/motos para recortar antes del OCR (Fase 2 ALPR)
RUN pip install --no-cache-dir fastapi uvicorn pydantic opencv-python-headless numpy requests ultralytics

# Pre-descargar YOLOv8n (~6 MB) en /app para no depender de red en cada arranque
RUN python3 -c "from ultralytics import YOLO; YOLO('yolov8n.pt')"

# Copiar el servidor de streaming y ALPR
COPY ezviz_stream_server.py /app/
COPY web /app/web

RUN mkdir -p /app/hls /app/recordings

EXPOSE 8080

CMD ["python3", "ezviz_stream_server.py"]
